                            25
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0" >
                    <StackPanel>
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Margin="0,10" >
                            Колличество<LineBreak/>
                                зубьев на<LineBreak/> 
                                    оборот
                        </TextBlock>
                        <TextBox x:Name="TeethTextBox" LostFocus="TeethTextBox_LostFocus" BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" SelectionTextBrush="#FFEFEFEF" Background="#FFEFEFEF" Margin="0,-10" >
                            2
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0" >
                    <StackPanel>
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Margin="0,10">
                            Угол поворота<LineBreak/>
                            градусы <Run/> минуты
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
                            <!-- Первый TextBox для градусов -->
                            <TextBox
                                x:Name="DegreesTextBox"
                                LostFocus="AngleTextBox_LostFocus"
                                Width="50" 
                                BorderThickness="0" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                VerticalAlignment="Center" 
                                TextAlignment="Center" 
                                Background="#FFEFEFEF"
                                Text="180"/>
                            <TextBlock 
                                Text="|" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                VerticalAlignment="Center" 
                                Margin="5,0"/>
                            <!-- Второй TextBox для минут -->
                            <TextBox 
                                x:Name="MinutesTextBox"
                                LostFocus="AngleTextBox_LostFocus"
                                Width="50" 
                                BorderThickness="0" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                VerticalAlignment="Center" 
                                TextAlignment="Center" 
                                Background="#FFEFEFEF"
                                Text="0"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,1,0" >
                    <StackPanel>
                        <TextBlock Text="ВРАЩЕНИЕ"  TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Margin="0,20" />
                        <ComboBox  SelectionChanged="ComboBox_SelectionChanged" Width="80" VerticalAlignment="Center"  Margin="0,10"  FontSize="12" FontWeight="Bold" IsEditable="True" IsReadOnly="True" Text="ВПРАВО" >
                            <ComboBoxItem Content="ВПРАВО" />
                            <ComboBoxItem Content="ВЛЕВО" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0" >
                    <StackPanel>
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Margin="0,10" >
                            Колличество<LineBreak/>
                                закаливаемых<LineBreak/> 
                                    зубьев
                        </TextBlock>
                        <TextBox BorderThickness="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" SelectionTextBrush="#FFEFEFEF" Background="#FFEFEFEF" Margin="0,-10" >
                            100
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="4" BorderBrush="Black" BorderThickness="0,0,1,0" >
                    <StackPanel>
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Margin="10,10" >
                            Текущий<LineBreak/>
                                закаливаемый<LineBreak/> 
                                    зубец
                        </TextBlock>
                        <TextBox x:Name="ToothCount" BorderThickness="0" IsReadOnly="True" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" SelectionTextBrush="#FFEFEFEF" Background="#FFEFEFEF" Margin="50,-10" >
                            2
                        </TextBox>
                    </StackPanel>
                </Border>
                <GroupBox Grid.ColumnSpan="10" Grid.RowSpan="3">

                    <WrapPanel Height="248" Margin="-3,0,-23,0" >

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5" >
                            <TextBlock Text="Режим работы:" FontSize="16"
                                    FontWeight="Bold" 
                            />
                            <TextBlock x:Name="ProjectName"
                                           Text="" FontSize="14"
                                           VerticalAlignment="Bottom"
                                           TextAlignment="Center"
                                           Margin="10,0,0,0"
                            />
                           </StackPanel>
                        <Line Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="2" 
                                    X1="0" Y1="0"
                                    X2="1140" Y2="0"
                                    Stroke="Black"
                                    StrokeThickness="1" 
                                    Width="1140" Height="2"/>
                    </WrapPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
        <log:LogPanel 
    Grid.Column="2" 
    Grid.ColumnSpan="3" 
    Grid.Row="4" 
    x:Name="LogContainer"
    Width="566"
    Height="116"
    HorizontalAlignment="Left"  
    VerticalAlignment="Top" Margin="103,61,0,0"/>
    </Grid>
</UserControl>
