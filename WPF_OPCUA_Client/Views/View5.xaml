<UserControl x:Class="WPF_OPCUA_Client.Views.View5"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
             mc:Ignorable="d" 
                     d:DesignHeight="800" d:DesignWidth="1280"
             Loaded="UserControl_Loaded"
             >

    <Grid PreviewKeyDown="Grid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="78"/>
            <RowDefinition Height="122*" />
            <RowDefinition Height="Auto" MinHeight="420"/>
            <RowDefinition Height="29*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="283*"/>
            <ColumnDefinition Width="237*"/>
            <ColumnDefinition Width="236*"/>
            <ColumnDefinition Width="524*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/IMG/Modes/Options.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Button x:Name="ResetCalibrationX" Content="Сброс калибровки ось X индуктора"
                Width="220"
                PreviewMouseLeftButtonDown="ResetCalibrationX_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="ResetCalibrationX_PreviewMouseLeftButtonUp"
                LostMouseCapture="ResetCalibrationX_LostMouseCapture"
                Height="60"
                HorizontalAlignment="Left"
                Background="Transparent"
                VerticalAlignment="Bottom"
                Grid.Row="2"
                Grid.Column="3"
                Panel.ZIndex="100" RenderTransformOrigin="-1.33,4.375" Margin="8,0,0,204">
            
        </Button>
            <Button x:Name="ResetCalibrationY"  Content="Сброс калибровки ось Y индуктора"
                Width="220"
                PreviewMouseLeftButtonDown ="ResetCalibrationY_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="ResetCalibrationY_PreviewMouseLeftButtonUp"
                LostMouseCapture="ResetCalibrationY_LostMouseCapture"
                    Background="Transparent"
                Height="60"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Row="2"
                Grid.Column="3"
                Panel.ZIndex="100" RenderTransformOrigin="-1.33,4.375" Margin="8,222,0,0"/>
        <Button x:Name="ResetCalibrationZ"  Content="Сброс калибровки ось Z индуктора"
                Width="220"
                PreviewMouseLeftButtonDown ="ResetCalibrationZ_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="ResetCalibrationZ_PreviewMouseLeftButtonUp"
                LostMouseCapture ="ResetCalibrationZ_LostMouseCapture"
                Height="60"
                Background="Transparent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Row="2"
                Grid.Column="3"
                Panel.ZIndex="100" RenderTransformOrigin="-1.33,4.375" Margin="8,288,0,0"/>
        <ScrollViewer Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="65,0,65,0" KeyDown="ScrollViewer_KeyDown">
            <StackPanel x:Name="AllZone" PreviewKeyDown="AllZone_PreviewKeyDown" Height="726">
                <TextBlock Text="Параметры движения" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" FontWeight="Bold" Margin="40,20,20,0" Width="175"/>

                <StackPanel Orientation="Horizontal" Margin="40,20,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Скорость перемещения "X"
                    </TextBlock>
                    <TextBox x:Name="VAxis2" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Скорость туширования (ось Z)
                    </TextBlock>
                    <TextBox x:Name="VShadingZ" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Скорость перемещения "Y"
                    </TextBlock>
                    <TextBox x:Name="VAxis3" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Возвращение в исходную точку режим "Вал"
                    </TextBlock>
                    <CheckBox x:Name="Return" VerticalAlignment="Center" Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged" HorizontalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Скорость перемещения "Зажим"
                    </TextBlock>
                    <TextBox x:Name="VAxis5" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Минимальное положение "X"
                    </TextBlock>
                    <TextBox x:Name="MinPosAxis2" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Максимальная ск-сть перемещения индукт-а "Z"
                    </TextBlock>
                    <TextBox x:Name="MaxVAxis4" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Максимальное положение "X"
                    </TextBlock>
                    <TextBox x:Name="MaxPosAxis2" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Минимальная скорость вращения
                    </TextBlock>
                    <TextBox x:Name="MinRotSpeed" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="0,1 об/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Минимальное положение "Y"
                    </TextBlock>
                    <TextBox x:Name="MinPosAxis3" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Максимальная скорость вращения
                    </TextBlock>
                    <TextBox x:Name="MaxRotSpeed" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock  Text="0,1 об/мин" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Максимальное положение "Y"
                    </TextBlock>
                    <TextBox x:Name="MaxPosAxis3" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Ускорение перемещения "X"
                    </TextBlock>
                    <TextBox x:Name="AccAxis2" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Минимальное положение "Z"
                    </TextBlock>
                    <TextBox x:Name="MinPosAxis4" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Ускорение перемещения "Y"
                    </TextBlock>
                    <TextBox Width="50" x:Name="AccAxis3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Максимальное положение "Z"
                    </TextBlock>
                    <TextBox x:Name="MaxPosAxis4" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Ускорение перемещения зажима "Z"
                    </TextBlock>
                    <TextBox x:Name="AccAxis5" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Ускорение перемещения индуктора "Z"
                    </TextBlock>
                    <TextBox x:Name="AccAxis4" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Right" Width="500" Margin="-2,0,0,0">
                        Параметры преобразователя частоты
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Ускорение перемещения вращения
                    </TextBlock>
                    <TextBox Width="50" x:Name="AccAxis1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Ток стабилизации
                    </TextBlock>
                    <TextBox x:Name="Amp" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="А" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Момент по оси "X"
                    </TextBlock>
                    <TextBox Width="50" x:Name="MomentAxis2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
                        Напряжение стабилизации
                    </TextBlock>
                    <TextBox Width="50" x:Name="Voltage" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="В" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Момент по оси "Y"
                    </TextBlock>
                    <TextBox Width="50" x:Name="MomentAxis3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300" Margin="200,0,0,0">
    Мощность стабилизации
                    </TextBlock>
                    <TextBox Width="50" x:Name="Power" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="кВт" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Момент оси индуктора "Z"
                    </TextBlock>
                    <TextBox x:Name="MomentAxis4" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Момент вращения
                    </TextBlock>
                    <TextBox x:Name="MomentAxis1" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                        Расстояние от индуктора до спреера
                    </TextBlock>
                    <TextBox x:Name="DistanceIndSpr" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="мм" FontSize="12" FontWeight="Bold" TextAlignment="Center" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                            Вращение в режиме "Вал"
                    </TextBlock>
                    <CheckBox x:Name="OnOffAxis1" Margin="16,0,18,0" Checked="OnOffAxis1_Checked" Unchecked="OnOffAxis1_Checked"></CheckBox>

                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <TextBlock FontSize="12" FontWeight="Bold" TextAlignment="Left" Width="300">
                            Момент оси зажима "Z"
                    </TextBlock>
                    <TextBox x:Name="MomentClamp" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>

                </StackPanel>
            </StackPanel>

        </ScrollViewer>
        <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="3" Content="{Binding CurrentView}">

        </ContentControl>
    </Grid>
</UserControl>
